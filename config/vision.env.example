# Camera Module 3 vision services
SPACEFARM_VISION_DATA_DIR=/var/lib/spacefarm/vision
SPACEFARM_VISION_EXPERIMENT=/opt/spacefarm/config/vision_experiment.json
SPACEFARM_VISION_INTERVAL_SEC=7200
SPACEFARM_VISION_CHECK_SEC=600
SPACEFARM_VISION_CAPTURE_LIGHT_MIN=50
SPACEFARM_VISION_TELEMETRY_STALE_SEC=120
SPACEFARM_VISION_DAILY_LIMIT=12
SPACEFARM_VISION_MAX_ATTEMPTS=3

# OpenAI-compatible multimodal endpoint. Keep the real key outside Git.
SPACEFARM_VISION_API_URL=https://ws-h2t3gmjicy4c4lr4.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SPACEFARM_VISION_API_KEY=replace-me
SPACEFARM_VISION_MODEL=qwen3.7-plus

# Pi -> Tencent Cloud durable outbox sync. Put the real token in a private env file.
SPACEFARM_CLOUD_BASE_URL=http://43.156.68.157:8790
SPACEFARM_CLOUD_SYNC_INTERVAL=15
VISION_UPLOAD_TOKEN=replace-me

# Add this same value to the UART gateway environment.
SPACEFARM_VISION_DB=/var/lib/spacefarm/vision/vision.sqlite3
